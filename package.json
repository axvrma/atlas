{
  "name": "atlas-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "storybook": "pnpm --filter @atlas/storybook dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/vitest.json",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "build:apps": "turbo run build",
    "preview": "node scripts/serve.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "audit:dependencies": "pnpm audit --prod",
    "report": "node scripts/quality-report.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "fake-indexeddb": "^6.2.0",
    "@atlas/core": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/mock-data": "workspace:*",
    "@atlas/ui": "workspace:*",
    "@atlas/tokens": "workspace:*",
    "lighthouse": "13.6.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.1",
      "glob": "^14.0.2"
    }
  }
}
